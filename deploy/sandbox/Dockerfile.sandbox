# Minimal untrusted-code sandbox image: runs as non-root with the Python
# interpreter only; the platform policies grant no network and no capabilities.
FROM python:3.12-slim

RUN useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin sandbox

COPY --chown=root:root sandbox_entrypoint.py /opt/sandbox/entrypoint.py

USER 65532
ENV PYTHONUNBUFFERED=1
WORKDIR /tmp
ENTRYPOINT ["python3", "/opt/sandbox/entrypoint.py"]
